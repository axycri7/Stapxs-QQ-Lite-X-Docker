# Copy this file to .env and adjust as needed.
# docker-compose reads these values with defaults; uncommented lines override them.

# Host ports to expose
# HTTP_PORT=80
# HTTPS_PORT=443

# Timezone
# TZ=Asia/Shanghai

# --- SSL certificate auto-renewal ---

# Validity period for generated certificates (days)
# SSL_VALIDITY_DAYS=90

# Renew when fewer than this many days remain
# SSL_RENEWAL_THRESHOLD_DAYS=7

# How often the monitor checks the certificate (hours)
# SSL_CHECK_INTERVAL_HOURS=24

# RSA key size
# SSL_KEY_SIZE=4096

# Certificate subject (DN format)
# SSL_SUBJECT=/C=US/ST=State/L=City/O=Organization/CN=localhost
