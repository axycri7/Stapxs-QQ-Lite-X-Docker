# SSL Certificate Auto-Renewal Configuration
# These environment variables can be set in entrypoint.sh or passed via docker environment
# 
# Example usage in docker-compose.yml:
#   environment:
#     - SSL_VALIDITY_DAYS=730
#     - SSL_RENEWAL_THRESHOLD_DAYS=14
#     - SSL_CHECK_INTERVAL_HOURS=12

# Validity period for generated certificates (in days)
# SSL_VALIDITY_DAYS=90

# Days threshold to trigger automatic renewal
# SSL_RENEWAL_THRESHOLD_DAYS=7

# How often to check certificate expiration 
# SSL_CHECK_INTERVAL_HOURS=24

# SSL certificate path
# SSL_CERT=/etc/ssl/certs/nginx-selfsigned.crt

# SSL private key path
# SSL_KEY=/etc/ssl/private/nginx-selfsigned.key

# SSL_KEY_SIZE=4096

# SSL_SUBJECT="/C=US/ST=State/L=City/O=Organization/CN=localhost"
